{
  "appId": "com.richlifetechnologies.fullswap",
  "productName": "Full Swap By Rich",
  "copyright": "Copyright © 2025 Rich Life Technologies",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "src/**/*",
    "package.json"
  ],
  "publish": {
    "provider": "github",
    "owner": "richlifetechnologies-lang",
    "repo": "NEW-UPDATED"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "installerSidebar": "build/installer-sidebar.bmp",
    "uninstallerSidebar": "build/installer-sidebar.bmp",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Full Swap By Rich",
    "displayLanguageSelector": false
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "universal"
        ]
      }
    ],
    "icon": "build/icon.png",
    "category": "public.app-category.video",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "Full Swap By Rich",
    "icon": "build/icon.png"
  },
  "extraMetadata": {
    "main": "src/main.js"
  }
}
