# ─────────────────────────────────────────────────────────────────────────────
# FULL SWAP BY RICH — Environment Variables
# Copy this file to .env and fill in your values before running docker-compose
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Used by docker-compose to create the Postgres container and connect the API.
DB_PASSWORD=change-this-to-a-strong-password

# Full Postgres URL (set this directly if you're using an external DB instead)
# DATABASE_URL=postgresql://fullswap:yourpassword@localhost:5432/fullswap

# ── Security ──────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# ── Admin Account ─────────────────────────────────────────────────────────────
# Password for admin@fullswap.app  (default: admin123 — change this!)
ADMIN_PASSWORD=admin123

# ── Networking ────────────────────────────────────────────────────────────────
# Port nginx listens on for HTTP (default 80)
HTTP_PORT=80

# Port nginx listens on for HTTPS (default 443) — requires TLS certs in nginx/certs/
HTTPS_PORT=443

# Comma-separated list of allowed CORS origins for the API.
# REQUIRED in production — leaving this blank allows requests from ANY origin.
# Example: ALLOWED_ORIGINS=https://fullswapbyrich.xyz,https://www.fullswapbyrich.xyz
ALLOWED_ORIGINS=https://fullswapbyrich.xyz,https://www.fullswapbyrich.xyz
